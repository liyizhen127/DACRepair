FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    build-essential git ca-certificates tcl-dev bison flex perl pkg-config python3 \
    libreadline-dev zlib1g-dev libssl-dev locales && \
    dpkg-query -W > /toolchain-packages.tsv && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 bench && mkdir -p /src /build /opt/pg /checks && chown -R bench:bench /src /build /opt/pg /checks
USER bench
WORKDIR /build
